# Pythonator's version. This is the only place it's written: pythonator/__init__.py reads it, and
# pyproject.toml, the app (title bar, --version), the PyInstaller builds and the release workflow
# all get it from there. To release: change it here, commit, push, then tag it with a "v" in front
# (VERSION=0.0.2 -> git tag v0.0.2 && git push origin v0.0.2).
VERSION=0.0.1
